<Window x:Class="CashBook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="منظومة الخزينة والمصرف" Height="760" Width="1150"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14"
        Background="#ECF0F1">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="15" CornerRadius="6">
            <TextBlock x:Name="HeaderText" Text="منظومة الخزينة والمصرف"
                       Foreground="White" FontSize="20" FontWeight="Bold"/>
        </Border>

        <TabControl Grid.Row="1" Margin="0,12,0,0" Background="White">

            <TabItem Header="  لوحة التحكم  ">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Rows="1" Columns="2" Margin="0,0,0,15">
                        <Border Background="#27AE60" CornerRadius="8" Margin="5" Padding="20">
                            <StackPanel>
                                <TextBlock Text="رصيد الخزينة (نقدي)" Foreground="White" FontSize="16"/>
                                <TextBlock x:Name="CashBalanceText" Text="0.00"
                                           Foreground="White" FontSize="28" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#2980B9" CornerRadius="8" Margin="5" Padding="20">
                            <StackPanel>
                                <TextBlock Text="رصيد المصرف" Foreground="White" FontSize="16"/>
                                <TextBlock x:Name="BankBalanceText" Text="0.00"
                                           Foreground="White" FontSize="28" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <GroupBox Grid.Row="1" Header="آخر 10 حركات" Padding="5">
                        <DataGrid x:Name="RecentGrid" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F9F9F9" RowHeight="28">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="100"/>
                                <DataGridTextColumn Header="النوع" Binding="{Binding TypeDisplay}" Width="80"/>
                                <DataGridTextColumn Header="الحساب" Binding="{Binding AccountDisplay}" Width="80"/>
                                <DataGridTextColumn Header="الجهة" Binding="{Binding Party}" Width="*"/>
                                <DataGridTextColumn Header="البيان" Binding="{Binding Note}" Width="*"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="  الحركات  ">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8F9FA" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="من:" VerticalAlignment="Center" Margin="5"/>
                            <DatePicker x:Name="FilterFrom" Width="130" Margin="5"/>
                            <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="5"/>
                            <DatePicker x:Name="FilterTo" Width="130" Margin="5"/>
                            <TextBlock Text="النوع:" VerticalAlignment="Center" Margin="5"/>
                            <ComboBox x:Name="FilterType" Width="100" Margin="5" SelectedIndex="0">
                                <ComboBoxItem Content="الكل"/>
                                <ComboBoxItem Content="دخول"/>
                                <ComboBoxItem Content="خروج"/>
                                <ComboBoxItem Content="تحويل"/>
                            </ComboBox>
                            <TextBlock Text="الجهة:" VerticalAlignment="Center" Margin="5"/>
                            <TextBox x:Name="FilterParty" Width="150" Margin="5"/>
                            <Button Content="بحث" Click="Filter_Click" Padding="15,5" Margin="5"/>
                            <Button Content="مسح" Click="ClearFilter_Click" Padding="15,5" Margin="5"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="إضافة حركة" Click="AddTransaction_Click"
                                Padding="15,8" Margin="0,0,10,0"
                                Background="#27AE60" Foreground="White" BorderThickness="0"/>
                        <Button Content="تعديل" Click="EditTransaction_Click" Padding="15,8" Margin="0,0,10,0"/>
                        <Button Content="حذف" Click="DeleteTransaction_Click" Padding="15,8" Margin="0,0,10,0"
                                Background="#E74C3C" Foreground="White" BorderThickness="0"/>
                        <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="15,0,0,0"
                                   Foreground="Gray"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="TransactionsGrid" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F9F9F9" RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="100"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding TypeDisplay}" Width="80"/>
                            <DataGridTextColumn Header="الحساب" Binding="{Binding AccountDisplay}" Width="80"/>
                            <DataGridTextColumn Header="إلى" Binding="{Binding ToAccountDisplay}" Width="80"/>
                            <DataGridTextColumn Header="الجهة" Binding="{Binding Party}" Width="*"/>
                            <DataGridTextColumn Header="التصنيف" Binding="{Binding Category}" Width="130"/>
                            <DataGridTextColumn Header="البيان" Binding="{Binding Note}" Width="*"/>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="  التقارير  ">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8F9FA" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="من:" VerticalAlignment="Center" Margin="5"/>
                            <DatePicker x:Name="ReportFrom" Width="130" Margin="5"/>
                            <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="5"/>
                            <DatePicker x:Name="ReportTo" Width="130" Margin="5"/>
                            <TextBlock Text="الحساب:" VerticalAlignment="Center" Margin="5"/>
                            <ComboBox x:Name="ReportAccount" Width="120" Margin="5" SelectedIndex="0">
                                <ComboBoxItem Content="الكل"/>
                                <ComboBoxItem Content="خزينة"/>
                                <ComboBoxItem Content="مصرف"/>
                            </ComboBox>
                            <Button Content="عرض" Click="ShowReport_Click" Padding="15,5" Margin="5"/>
                            <Button Content="طباعة PDF" Click="ExportPdf_Click"
                                    Padding="15,5" Margin="5"
                                    Background="#E67E22" Foreground="White" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="ReportGrid" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F9F9F9" RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="100"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding TypeDisplay}" Width="80"/>
                            <DataGridTextColumn Header="الحساب" Binding="{Binding AccountDisplay}" Width="80"/>
                            <DataGridTextColumn Header="إلى" Binding="{Binding ToAccountDisplay}" Width="80"/>
                            <DataGridTextColumn Header="الجهة" Binding="{Binding Party}" Width="*"/>
                            <DataGridTextColumn Header="التصنيف" Binding="{Binding Category}" Width="130"/>
                            <DataGridTextColumn Header="البيان" Binding="{Binding Note}" Width="*"/>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="  الإعدادات  ">
                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10">
                        <TextBlock Text="اسم المؤسسة:" VerticalAlignment="Center" Width="130"/>
                        <TextBox x:Name="CompanyNameText" Width="400" Padding="6"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10">
                        <TextBlock Text="العملة:" VerticalAlignment="Center" Width="130"/>
                        <TextBox x:Name="CurrencyText" Width="100" Padding="6" Text="د.ل"/>
                    </StackPanel>

                    <Button Grid.Row="2" Content="حفظ الإعدادات" Click="SaveSettings_Click"
                            Padding="20,8" Margin="0,20,0,0" HorizontalAlignment="Left"
                            Background="#27AE60" Foreground="White" BorderThickness="0"/>

                    <GroupBox Grid.Row="3" Header="النسخ الاحتياطي" Margin="0,30,0,0" Padding="15">
                        <StackPanel>
                            <TextBlock Text="ملف قاعدة البيانات:" FontWeight="Bold"/>
                            <TextBlock x:Name="DbPathText" Foreground="Gray" Margin="0,5,0,15" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="نسخ احتياطي" Click="Backup_Click" Padding="15,8" Margin="0,0,10,0"/>
                                <Button Content="فتح مجلد البيانات" Click="OpenFolder_Click" Padding="15,8"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="جاهز"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
