<Window x:Class="CashBook.TransactionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حركة" Height="540" Width="520"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="14"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="التاريخ:" VerticalAlignment="Center" Margin="5"/>
        <DatePicker Grid.Row="0" Grid.Column="1" x:Name="DatePicker" Margin="5" Height="30"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="النوع:" VerticalAlignment="Center" Margin="5"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="TypeCombo" Margin="5" Height="30"
                  SelectionChanged="TypeCombo_Changed">
            <ComboBoxItem Content="دخول"/>
            <ComboBoxItem Content="خروج"/>
            <ComboBoxItem Content="تحويل"/>
        </ComboBox>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="الحساب:" VerticalAlignment="Center" Margin="5"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="AccountCombo" Margin="5" Height="30">
            <ComboBoxItem Content="خزينة"/>
            <ComboBoxItem Content="مصرف"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" x:Name="ToAccountLabel" Text="إلى حساب:"
                   VerticalAlignment="Center" Margin="5" Visibility="Collapsed"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ToAccountCombo" Margin="5" Height="30"
                  Visibility="Collapsed">
            <ComboBoxItem Content="خزينة"/>
            <ComboBoxItem Content="مصرف"/>
        </ComboBox>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="المبلغ:" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="AmountText" Margin="5" Padding="6" Height="30"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="الجهة:" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="PartyText" Margin="5" Padding="6" Height="30"
                 ToolTip="مثال: أحمد / فاتورة كهرباء"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="التصنيف:" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="CategoryText" Margin="5" Padding="6" Height="30"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="البيان / ملاحظة:" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="7" Grid.Column="1" x:Name="NoteText" Margin="5" Padding="6"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Height="80"/>

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,15,0,0">
            <Button Content="حفظ" Click="Save_Click" Padding="30,10" Margin="5"
                    Background="#27AE60" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            <Button Content="إلغاء" Click="Cancel_Click" Padding="30,10" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
